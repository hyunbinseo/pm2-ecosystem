{
	"name": "pm2-ecosystem",
	"version": "7.1.1",
	"description": "Type PM2 configuration files. Use JSDoc or the define-app function.",
	"homepage": "https://github.com/hyunbinseo/pm2-ecosystem#readme",
	"bugs": {
		"url": "https://github.com/hyunbinseo/pm2-ecosystem/issues"
	},
	"license": "AGPL-3.0",
	"author": "Hyunbin Seo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyunbinseo/pm2-ecosystem.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"bump": "node cli/index.ts",
		"prepack": "tsdown",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@types/node": "^26.6.6",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"publint": "^0.3.25",
		"simple-git": "^4.0.2",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2",
		"valibot": "^1.5.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	}
}
